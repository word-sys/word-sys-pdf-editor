{
    "app-id": "io.github.word_sys.word-sys-pdf-editor",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "command": "word-sys-pdf-editor",
    "finish-args": [
        "--share=ipc",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--device=dri"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/man",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "python3-numpy",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} \"numpy\" --no-build-isolation"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/45/8f/9beacf79ca7c650688ad0baa80931adb988fe6e6e5d5903c23cc3dbd70eb/numpy-2.5.3-cp314-cp314-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl",
                    "sha256": "b0521d0f4aebb6e06189451025fa17a913287b13c03d5fe05c017333b654ea5b",
                    "only-arches": [
                        "x86_64"
                    ]
                },
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/9c/72/12918652e7912ef9751e8694c88820fcd1908e0618cb23f5f3caa6004b7b/numpy-2.5.3-cp314-cp314-manylinux_2_27_aarch64.manylinux_2_28_aarch64.whl",
                    "sha256": "be5a8381859b6da607c84f4f7d6847725f1cf1853ef8a2c9e115b7d58bef47dc",
                    "only-arches": [
                        "aarch64"
                    ]
                }
            ]
        },
        {
            "name": "python3-PyMuPDF",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} \"PyMuPDF\" --no-build-isolation"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/c7/06/dace3e27af26690cb20bead80dbac42941b0841eb689b8aabbd67dde16f0/pymupdf-1.28.2-cp310-abi3-manylinux_2_28_x86_64.whl",
                    "sha256": "397d6715c1f0df7548a92d0afd8ce370fc48fa47aeefac16be2bc04a16a8227f",
                    "only-arches": [
                        "x86_64"
                    ]
                },
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/d2/86/4a68f080b71b46802178346af46486e1697508e760855ff5f3b218a6dff7/pymupdf-1.28.2-cp310-abi3-manylinux_2_28_aarch64.whl",
                    "sha256": "3050a233dde1211efe89ada74e2add6238436434159f46097a1423aad2842545",
                    "only-arches": [
                        "aarch64"
                    ]
                }
            ]
        },
        {
            "name": "python3-anyconvert",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} \"anyconvert\" --no-build-isolation"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/c3/ad/70ec844364ef631de8ff5eecae890e144f2d8ce843a46c08c0ca3379e6a3/anyconvert-0.1.8-py3-none-any.whl",
                    "sha256": "70daaf3688a8851e6770242b16c499be9e45ca38c526e30283a53b8a000db3e3"
                }
            ]
        },
        {
            "name": "word-sys-pdf-editor",
            "buildsystem": "simple",
            "build-commands": [
                "sed -i 's/GLib.set_prgname(\"word-sys-pdf-editor\")/GLib.set_prgname(os.environ.get(\"FLATPAK_ID\", \"io.github.word_sys.word-sys-pdf-editor\"))/' word_sys_pdf_editor/main.py",
                "pip3 install --verbose --exists-action=i --no-index --no-build-isolation --no-deps --prefix=${FLATPAK_DEST} .",
                "install -Dm644 io.github.word_sys.word-sys-pdf-editor.desktop /app/share/applications/io.github.word_sys.word-sys-pdf-editor.desktop",
                "install -Dm644 io.github.word_sys.word-sys-pdf-editor.metainfo.xml /app/share/metainfo/io.github.word_sys.word-sys-pdf-editor.metainfo.xml",
                "install -Dm644 word_sys_pdf_editor/img/f-pv1.svg /app/share/icons/hicolor/scalable/apps/io.github.word_sys.word-sys-pdf-editor.svg",
                "install -Dm644 word_sys_pdf_editor/img/f-pv1.svg /app/share/icons/hicolor/scalable/apps/f-pv1.svg"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/word-sys/word-sys-pdf-editor.git",
                    "tag": "v1.11.1",
                    "commit": "b21c151ac7e0d01012943a553ced0136d0112926"
                }
            ]
        }
    ]
}
