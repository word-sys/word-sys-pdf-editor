#!/bin/sh
set -e

INSTALL_DIR="/opt/word-sys-pdf-editor"
VENV_DIR="${INSTALL_DIR}/.venv"

case "$1" in
    configure)
        echo "word-sys-pdf-editor: Setting up Python virtual environment..."

        python3 -m venv --system-site-packages "${VENV_DIR}"

        echo "word-sys-pdf-editor: Installing PyMuPDF, numpy, anyconvert, and security dependencies..."
        "${VENV_DIR}/bin/pip" install --upgrade --quiet pymupdf numpy "anyconvert>=0.1.9" "cryptography" "pyhanko>=0.25.0" "python-pkcs11>=0.7.0"

        echo "word-sys-pdf-editor: Setup complete."
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac


exit 0
