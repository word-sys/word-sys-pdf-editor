#!/bin/sh
set -e

INSTALL_DIR="/opt/word-sys-pdf-editor"
VENV_DIR="${INSTALL_DIR}/.venv"

case "$1" in
    configure)
        echo "word-sys-pdf-editor: Setting up Python virtual environment..."

        python3 -m venv --system-site-packages "${VENV_DIR}"

        echo "word-sys-pdf-editor: Installing PyMuPDF, numpy, anyconvert, OCR, and security dependencies..."
        "${VENV_DIR}/bin/pip" install --upgrade --quiet --prefer-binary "PyMuPDF>=1.24.0,<2.0.0" numpy "anyconvert>=0.1.11" "cryptography>=41.0.0" "pyhanko[image-support,opentype]>=0.25.0" "pyhanko-certvalidator>=0.24.0" "python-pkcs11>=0.7.0" "asn1crypto>=1.5.1" "Pillow>=9.0.0" certifi

        echo "word-sys-pdf-editor: Setup complete."
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac


exit 0
